#include <iostream>
using namespace std;

void read(int a[], int n)
{
    for(int i = 0; i < n; i++)
        cin >> a[i];
}

void swap(int &x, int &y)
{
    int t = x;
    x = y;
    y = t;
}

void sort(int a[], int n)
{
    for(int i = 0; i < n-1; i++)
        for(int j = i+1; j < n; j++)
            if(a[i] > a[j])
                swap(a[i], a[j]);
}

void display(int a[], int n)
{
    for(int i = 0; i < n; i++)
        cout << a[i] << " ";
}

int main()
{
    int a[50], n;

    cout << "Enter size: ";
    cin >> n;

    cout << "Enter numbers: ";
    read(a, n);

    sort(a, n);

    cout << "Sorted array: ";
    display(a, n);

    return 0;
}
