#include <iostream>
using namespace std;

void read(int a[], int n)
{
    for(int i = 0; i < n; i++)
        cin >> a[i];
}

void swapNum(int &x, int &y)
{
    int temp = x;
    x = y;
    y = temp;
}

void sortArray(int a[], int n)
{
    for(int i = 0; i < n-1; i++)
        for(int j = i+1; j < n; j++)
            if(a[i] > a[j])
                swapNum(a[i], a[j]);
}

void display(int a[], int n)
{
    for(int i = 0; i < n; i++)
        cout << a[i] << " ";
}

int main()
{
    int a[50], n;

    cout << "Enter size: ";
    cin >> n;

    cout << "Enter numbers: ";
    read(a, n);

    sortArray(a, n);

    cout << "Sorted array: ";
    display(a, n);

    return 0;
}
