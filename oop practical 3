
#include <iostream>
using namespace std;

void readArray(int a[], int n)
{
    cout << "Enter " << n << " elements: ";
    for (int i = 0; i < n; i++)
    {
        cin >> a[i];
    }
}

void displayArray(const int a[], int n)
{
    for (int i = 0; i < n; i++)
    {
        cout << a[i] << " ";
    }
    cout << endl;
}

void swapValues(int &x, int &y)
{
    int temp = x;
    x = y;
    y = temp;
}

void sortArray(int a[], int n)
{
    for (int i = 0; i < n - 1; i++)
    {
        for (int j = 0; j < n - i - 1; j++)
        {
            if (a[j] > a[j + 1])
            {
                swapValues(a[j], a[j + 1]);
            }
        }
    }
}

int main()
{
    int a[100], n;

    cout << "Enter number of elements: ";
    cin >> n;

    readArray(a, n);

    cout << "Original array: ";
    displayArray(a, n);

    sortArray(a, n);

    cout << "Sorted array in ascending order: ";
    displayArray(a, n);

    return 0;
}
