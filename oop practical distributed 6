#include <iostream>
using namespace std;

class Complex {
    int r, i;

public:
    Complex(int a = 0, int b = 0) {
        r = a;
        i = b;
    }

    void input() {
        cin >> r >> i;
    }

    Complex operator +(Complex c) {
        return Complex(r + c.r, i + c.i);
    }

    Complex operator -(Complex c) {
        return Complex(r - c.r, i - c.i);
    }

    Complex operator *(Complex c) {
        return Complex(r*c.r - i*c.i, r*c.i + i*c.r);
    }

    void display() {
        cout << r << " + " << i << "i" << endl;
    }
};

int main() {
    Complex a, b, c;

    cout << "Enter first complex number: ";
    a.input();

    cout << "Enter second complex number: ";
    b.input();

    c = a + b;
    cout << "Addition: ";
    c.display();

    c = a - b;
    cout << "Subtraction: ";
    c.display();

    c = a * b;
    cout << "Multiplication: ";
    c.display();

    return 0;
}
