
#include <iostream>
using namespace std;

class Shape
{
public:
    virtual void area() = 0;

    virtual ~Shape() {}
};

class Circle : public Shape
{
public:
    void area() override
    {
        float r = 3;
        cout << "Area of circle = " << 3.14159 * r * r << endl;
    }
};

class Rectangle : public Shape
{
public:
    void area() override
    {
        int l = 5, b = 4;
        cout << "Area of rectangle = " << l * b << endl;
    }
};

int main()
{
    Circle c;
    Rectangle r;

    Shape *ptr;

    ptr = &c;
    ptr->area();

    ptr = &r;
    ptr->area();

    return 0;
}
